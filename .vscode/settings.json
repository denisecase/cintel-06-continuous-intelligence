// ============================================================
// .vscode/settings.json (ALL-REPOS)
// ============================================================
// Updated: 2026-10-11
//
// WHAT: A configuration file for project-specific VS Code editor settings.
//       JSONC is JSON with comments, supported by VS Code configuration files.
//       This file identifies preferred formatters for common file types.
//
// WHEN: Use in professional projects to share consistent editor conventions
//       without requiring contributors to configure everything individually.
//
// WHY: Consistent formatting makes project files easier to read and maintain.
//      Shared settings help contributors use appropriate formatting tools
//      while avoiding unnecessary changes to their development environments.
//
// HOW: VS Code reads these settings when the project folder is opened.
//      Formatting is not automatically triggered when files are saved.
//      Users can explicitly request formatting when needed.
//
// SKILLS: VS Code, workspace settings, code formatting, JSONC,
//         project configuration, and team collaboration.
//
// REQ: Shared settings MUST NOT modify Python environments, terminals,
//      execution commands, or other unrelated development behavior.
//
// OBS: External formatters should be recommended in extensions.json.
//      VS Code's built-in JSON and JSONC formatters need no installation.
// OBS: Language-specific formatter settings are listed alphabetically.
// ============================================================
{
  // WHY: Avoid automatic file changes on save; format explicitly when intended.
  "editor.formatOnSave": false,

  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  }
}
